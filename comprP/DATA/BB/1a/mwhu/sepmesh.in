mesh2d
  coarse(unit=0.02)
  points
    p1=(0,0,1)
    p2=(1,0,1)
    p3=(1,1,1)
    p4=(0,1,1)
    p5=(0,0.95,1)
    p6=(0.05,0.95,1)
    p7=(0.95,0.95,1)
    p8=(1,0.95,1)
    p9=(0.95,1,1)
    p10=(0.05,1,1)
  curves
    c1=cline2(p1,p2)
    c2=cline2(p2,p8)
    c3=cline2(p8,p3)
    c4=cline2(p3,p9)
    c5=cline2(p9,p10)
    c6=cline2(p10,p4)
    c7=cline2(p4,p5)
    c8=cline2(p5,p1)
    c9=cline2(p5,p6)
    c10=cline2(p6,p7)
    c11=cline2(p7,p8)
    c12=cline2(p7,p9)
    c13=cline2(p6,p10)
*   * bottom
    c100=curves(c1)
*   * top
    c101=curves(c4,c5,c6)
*   * right side
    c102=curves(c2,c3)
*   * left side
    c103=curves(c7,c8)
*   * bottom of lithosphere
    c104=curves(c9,c10,c11)   
  surfaces
    s1=general4(c1,c2,-c104,c8)
    s2=general4(c9,c13,c6,c7)
    s3=general4(c10,c12,c5,-c13)
    s4=general4(c11,c3,c4,-c12)
  renumber(method=2)
  plot
end
