&comprP_nml
Ra=1e4   ! Rayleigh number
Rb_local=0e0
Di=0.0
delta1K=F

cyl = .true.  ! cylindrical geometry
subtract_rotation=T ! make sure to remove the null space (rigid rotation)
stokes_via_user=T

steady=T ! 0=time-dependent computation
  nsteady_max=40
  relax=0.5
  metupw=0
  eps=1e-3

isolmethod8=1
isolmethod9=0
itype_stokes=900
ipetsc8=2
imatrix8=6
ipetsc9=0
imatrix9=1

ncor=1    ! number of corrector steps
   tfac=2.0 ! fraction of CFL criterion. Negative sign indicates we'll use dimensional time at the input
   dtout_d= 0.01 ! in Byr
   tmax_d = 4.5  ! in Byr
   nbetween=2

iclc=2   ! number of curves with local transformations of b.c.
   icloc= 40, 41    ! curve numbers of those curves
nbp=1
   iboundpoints=1

krestart=-1  ! 1000: start from Tstartfile (not UVstartfile); -1 conductive
Tstartfile='T_start.nf'
UVstartfile='UV_start.nf'
output_velocity_solution=.true.

jtypv=0  ! eta=eta(T,p)
b_eta=6.908
nlay=3   ! number of layers
   zint_d= 0.04495,0.2813   ! nlay-1 interface depths   used in viscosity function
   viscl=1000,1,30   ! eta0 in the layers

iiqtype=0 ! compute internal heating as function of BSE
q_layer_d=1.5,1.5,1.5 ! From JP original : very large contribution estimated of cooling? 

ibottom=41  ! bottom curve number
itop=40  ! top curve number
r1=0.4292 ! inner radius
r2=1.4292 ! outer radius

 
ipmax=800

gable_plates=T
nplates=8   ! by default, plate boundaries are equally spaced
  whalf=0.05
  recomputeG=T
  istress_curve=43


/

